# Omni Cyber Guard — Backend Environment
#
# Copy to backend/.env and change every value marked CHANGE ME.
# The application refuses to start with ENVIRONMENT=production while any of
# these still hold their shipped default (see app/core/config.py).

ENVIRONMENT=development

# CHANGE ME — generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-this-to-a-random-64-char-secret-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# The application must NOT connect as a PostgreSQL superuser. Superusers are
# exempt from every row-level security policy — silently — which would make the
# tenant-isolation policies decorative. docker-compose creates the ocg_app role
# with NOSUPERUSER NOBYPASSRLS for this reason.
DATABASE_URL=postgresql://ocg_app:ocg_password@postgres:5432/omni_cyber_guard
REDIS_URL=redis://redis:6379/0

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# --- Tenant isolation --------------------------------------------------------
# PostgreSQL row-level security, enforced independently of application query
# filters. The API verifies at startup that the policies are actually in force
# and refuses to start in production if they are not.
ENABLE_ROW_LEVEL_SECURITY=true

# --- Credential vault --------------------------------------------------------
# Fernet key protecting stored scan credentials. Deliberately separate from
# SECRET_KEY so rotating session signing does not make the vault unreadable.
# Required in production. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

BACKEND_CORS_ORIGINS=["http://localhost:3000"]

# First-run bootstrap account, created only when the users table is empty.
FIRST_SUPERADMIN_EMAIL=admin@omnidigitalsolution.com
# CHANGE ME
FIRST_SUPERADMIN_PASSWORD=ChangeMe!12345

# --- Rate limiting -----------------------------------------------------------
# Per client address, per minute, across the API.
RATE_LIMIT_PER_MINUTE=120
# Tighter budget for credential-accepting endpoints (login, refresh).
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Enable ONLY when running behind a reverse proxy you control. Otherwise a
# client can forge X-Forwarded-For and evade the rate limit.
TRUST_PROXY_HEADERS=false

# --- Passive network monitor -------------------------------------------------
# Requires scapy and CAP_NET_RAW. Observes traffic and raises alerts; it never
# injects, forges or drops packets.
ENABLE_PASSIVE_MONITOR=true

# Report a specific local IP instead of auto-detecting (useful on Docker Desktop).
# OVERRIDE_LOCAL_IP=192.168.1.20

# --- AI security engineer ----------------------------------------------------
# Off by default, and it stays off until all three of the settings below are
# supplied. The assistant retrieves records from this database with read-only,
# permission-checked queries and validates every answer against what those
# queries returned; the language model only phrases the result. Without one,
# the Security Engineer page reports "not configured" rather than showing an
# error where analysis belongs.
#
# Supported: openai_compatible (OpenAI, vLLM, LiteLLM, llama.cpp server, Groq,
# Azure OpenAI) or ollama. The model MUST support tool calling — there is no
# free-text fallback, by design.
#
# AGENT_LLM_PROVIDER=ollama
# AGENT_LLM_BASE_URL=http://ollama:11434
# AGENT_LLM_MODEL=llama3.1
# openai_compatible only:
# AGENT_LLM_API_KEY=
AGENT_LLM_TIMEOUT_SECONDS=60
# Retrieve-then-reason rounds allowed before the assistant must answer from
# what it has (and say that the retrieval was partial).
AGENT_MAX_TOOL_ITERATIONS=6
# Rows any single retrieval may return. Bounded so the whole evidence set can
# be attached to the response, which is what makes an answer checkable.
AGENT_MAX_ROWS_PER_TOOL=50
# How long an operator has to confirm an action the assistant proposed before
# it must be re-checked against current data.
AGENT_PROPOSAL_TTL_MINUTES=60

# --- External discovery integrations -----------------------------------------
# All unset by default. An unconfigured integration reports itself as
# unconfigured on its page, naming exactly what is missing; it never writes a
# placeholder record into the inventory it was meant to populate.
# Implemented in app/services/integrations/.

# Cloud posture (read-only). AWS needs a principal with the SecurityAudit
# managed policy or equivalent; discovery calls ec2:DescribeInstances only.
# Also requires: pip install boto3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-west-1

# Azure needs an app registration with the Reader role on the subscription.
# Also requires: pip install azure-identity azure-mgmt-resource
# The same three AZURE_* values below are reused by the Entra ID identity
# adapter, which additionally needs the User.Read.All application permission.
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=
# AZURE_SUBSCRIPTION_ID=

# Okta: a read-only API token from Security -> API -> Tokens.
# Discovery issues GET /api/v1/users only.
# OKTA_ORG_URL=https://your-org.okta.com
# OKTA_API_TOKEN=
